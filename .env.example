PORT=5000
MONGO_URI=mongodb://localhost:27017/mindmesh
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional AI provider settings for structured analysis and embeddings.
# If these are unset, MindMesh falls back to local heuristic analysis.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.32

# Email verification. development returns the code in the API response and does not send mail.
# For real delivery, set EMAIL_DELIVERY=provider, RESEND_API_KEY, and EMAIL_FROM.
EMAIL_DELIVERY=development
RESEND_API_KEY=
EMAIL_FROM=MindMesh <verify@yourdomain.com>
