PORT=5000
MONGO_URI=mongodb://localhost:27017/mindmesh
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.32

# Email verification.
# development: do not send email; the API returns devCode for local testing.
# Leave EMAIL_DELIVERY unset and set the Resend values to send real email.
EMAIL_DELIVERY=development
RESEND_API_KEY=
EMAIL_FROM=MindMesh <verify@yourdomain.com>
